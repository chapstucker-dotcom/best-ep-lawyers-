# ============================================================
# Best EP Lawyers – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ----------------------------------------------------------
# Supabase – required for all features
# Get these from:
# https://supabase.com/dashboard/project/yvcuhnnhspqjfnrbkhok/settings/api
# ----------------------------------------------------------
VITE_SUPABASE_URL=https://yvcuhnnhspqjfnrbkhok.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (server-side / Edge Functions only – never expose to browser)
SUPABASE_URL=https://yvcuhnnhspqjfnrbkhok.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ----------------------------------------------------------
# Site / OAuth redirect URL
# Local dev:   http://localhost:8080
# Production:  https://elpasosbestlawyers.com
# ----------------------------------------------------------
VITE_SITE_URL=http://localhost:8080
SITE_URL=https://elpasosbestlawyers.com

# ----------------------------------------------------------
# Stripe – required for subscription / payment features
# Get these from: https://dashboard.stripe.com/apikeys
# ----------------------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here

# These are used in Supabase Edge Functions (server-side only)
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here
