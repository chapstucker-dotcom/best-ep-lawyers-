# ============================================================
# Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ------------------------------------------------------------
# Frontend (Vite/React) — Required for Build
# These VITE_* variables are embedded into the compiled
# static site and are safe to expose publicly.
# Set them as GitHub Secrets AND as Vercel environment vars.
# ------------------------------------------------------------

# Required: Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Required: Supabase anonymous (public) key
# Get from: Supabase Dashboard → Settings → API → "anon" key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Stripe publishable key (frontend Stripe Elements)
# Not actively used by current code; add if you integrate Stripe on the frontend.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key

# Optional: Site URL (used by Supabase Edge Functions, not the Vite build)
# SITE_URL=https://elpasosbestlawyers.com

# ------------------------------------------------------------
# Vercel Deployment — GitHub Secrets (CI/CD)
# Set these in GitHub → Settings → Secrets and variables → Actions
# ------------------------------------------------------------

# Required: Vercel personal access token (already configured)
# VERCEL_TOKEN=your-vercel-token

# Optional: Vercel org/team ID (only needed for team-scoped projects)
# VERCEL_ORG_ID=your-vercel-org-id

# Optional: Vercel project ID (only needed for explicit project targeting)
# VERCEL_PROJECT_ID=your-vercel-project-id

# ------------------------------------------------------------
# Supabase Edge Functions — Supabase Dashboard Secrets ONLY
# Set via: supabase secrets set KEY=value --project-ref <ref>
# Do NOT put these in GitHub secrets or Vercel.
# ------------------------------------------------------------

# STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SITE_URL=https://elpasosbestlawyers.com
