# --- Supabase (required) -----------------------------------
# Get from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://yvcuhnnhspqjfnrbkhok.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Stripe (optional — only if using Stripe on the frontend) ---
# Get from: Stripe Dashboard → Developers → API keys (publishable key)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key-here

# --- Site URL (optional — used by Supabase Edge Functions) ---
SITE_URL=https://elpasosbestlawyers.com
